# ── Server ──────────────────────────────────────────────────
PORT=4000
NODE_ENV=development

# ── MySQL ───────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=yourpassword
DB_NAME=glowup

# ── JWT ─────────────────────────────────────────────────────
JWT_ACCESS_SECRET=change_this_to_a_very_long_random_string_min_64_chars
JWT_REFRESH_SECRET=change_this_to_another_very_long_random_string_min_64_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Email (SMTP) ─────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@glowup.app
SMTP_PASS=your_smtp_password
EMAIL_FROM="GlowUp <noreply@glowup.app>"

# ── App ──────────────────────────────────────────────────────
CLIENT_URL=http://localhost:3000
COOKIE_SECRET=another_long_random_secret_for_cookie_signing
